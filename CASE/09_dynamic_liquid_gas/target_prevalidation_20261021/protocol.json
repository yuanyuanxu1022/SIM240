{
  "version": "target-prevalidation-diagnostic-v1",
  "scope": "initialization audit and a single explicitly launched diagnostic trajectory; not formal validation",
  "max_diagnostic_steps": 200,
  "model_material": "separate idealized liquid and gas; NOT measured GHY",
  "phi_zero": "liquid",
  "phi_one": "gas",
  "backend_arrays": {"RHOS": [1.0, 0.0012], "TAUS": [1.0, 1.125]},
  "tau_phase": 1.0,
  "phase_penalty_ADDEND": 0.0,
  "initial_hydrodynamic_pressure_lattice": 0.0,
  "angle_degrees_liquid_side": 90.0,
  "max_Mach_strict": 0.05,
  "rho_strictly_positive_before_coupling": true,
  "max_mapping_absolute_error": 1e-10,
  "phi_clipping": false,
  "phase_amount_renormalization": false,
  "cases": {
    "laplace": {"dimensions_requested_lattice": [64,64,64], "radius_lattice": 16, "periodic": [true,true,true]},
    "contact": {"dimensions_requested_lattice": [64,40,64], "radius_lattice": 18, "periodic": [true,false,true], "center_at_analytic_lower_wall": true},
    "flat_liquid": {"dimensions_requested_lattice": [16,31,16], "gap_lattice_required": 30, "gap_nm": 75, "gradient_Pa_m": 1e7},
    "flat_gas": {"dimensions_requested_lattice": [16,31,16], "gap_lattice_required": 30, "gap_nm": 75, "gradient_Pa_m": 1e7}
  },
  "formal_protocol_frozen": false,
  "formal_launch_allowed": false,
  "formal_gaps": ["target-parameter transient stability", "mechanical-pressure recovery and spatial bulk masks", "equilibrium/time-window budget", "fitted radius and contact angle assessment", "physical mobility and interface-width sensitivity", "single-phase steady K and velocity error validation"],
  "NUMERICAL_GATE": "NOT_EVALUATED",
  "RESULT_PASS": "NOT_EVALUATED",
  "geometry_PASS": "NOT_EVALUATED"
}
