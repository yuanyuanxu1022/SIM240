+def validate_array_kinds(system,solution):
+    a,b=system.get('record_kind'),solution.get('record_kind')
+    if not isinstance(a,str) or a not in ARRAY_KIND_BY_PARENT.values() or a!=b:
+        raise ValueError('ARRAY_RECORD_KIND_UNKNOWN_MISSING_OR_MISMATCHED')
+    return a
+
+
+def validate_record_kinds(started,capture,system=None,solution=None):
+    a,b=started.get('kind'),capture.get('kind')
+    if not isinstance(a,str) or a not in ARRAY_KIND_BY_PARENT or a!=b:
+        raise ValueError('PARENT_RECORD_KIND_UNKNOWN_MISSING_OR_MISMATCHED')
+    if system is not None or solution is not None:
+        if system is None or solution is None or validate_array_kinds(system,solution)!=ARRAY_KIND_BY_PARENT[a]:
+            raise ValueError('PARENT_ARRAY_RECORD_KIND_MISMATCHED')
+    return a
 
 
