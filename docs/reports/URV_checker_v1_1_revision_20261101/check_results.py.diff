+def regression_check(run, reference, K, output):
+    """F02: retain the complete computed comparison before either stop condition."""
+    output=output_location(output,[run,reference['directory']],require_new=False)
+    baseline=Path(reference['directory'])
+    need(sha(baseline/'result.txt')==reference['result_sha256'], 'regression reference binding')
+    need(sha(baseline/'diagnostics.csv')==reference['diagnostics_sha256'], 'regression diagnostics binding')
+    baseline_K=float(kv(baseline/'result.txt')['Keff_m3'])
+    err=abs(K/baseline_K-1)
+    legacy=compare_legacy(run,baseline)
+    report=dict(relative_K_change=err,K_new_m3=K,K_baseline_m3=baseline_K,
+        K_relative_limit=LIMITS['statistics_port_regression']['K_relative_max'],legacy=legacy,
+        K_gate_PASS=err<=LIMITS['statistics_port_regression']['K_relative_max'],
+        legacy_gate_PASS=legacy['all_exact'],independent_result_accepted=False)
+    save(output/'regression_comparison.json',report)
+    need(report['K_gate_PASS'], 'h75 K port regression')
+    need(legacy['all_exact'], 'legacy trajectory difference needs separate explanation; fail-stop')
+    return dict(relative_K_change=err,legacy=legacy)
