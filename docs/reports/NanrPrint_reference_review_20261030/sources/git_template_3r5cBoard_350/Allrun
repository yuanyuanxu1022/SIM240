#!/bin/bash
set -e

rm -rf 0 processor* postProcessing dynamicCode
rm -rf [1-9]* [0-9]*.[0-9]*
rm -rf constant/polyMesh

blockMesh > log.blockMesh

topoSet > log.topoSet

cp -r 0.org 0
setFields > log.setFields
setFields -dict system/setMoldMaskDict > log.setMoldMask

decomposePar -force > log.decomposePar

mpirun -np 8 foamRun -parallel > log.interFoam

echo ">>> Single-layer imprint mesh and initial fields prepared."
