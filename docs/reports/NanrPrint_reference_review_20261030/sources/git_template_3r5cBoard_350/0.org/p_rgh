FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p_rgh;
}

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 1e5;

boundaryField
{
    top
    {
        type            fixedFluxPressure;
        gradient        uniform 0;
        value           uniform 1e5;
    }
    bottom
    {
        type            fixedFluxPressure;
        gradient        uniform 0;
        value           uniform 1e5;
    }
    left
    {
        type fixedValue;
        value uniform 1e5;
    }
    right
    {
        type fixedValue;
        value uniform 1e5;
    }
    front
    {
        type fixedValue;
        value uniform 1e5;
    }
    back
    {
        type fixedValue;
        value uniform 1e5;
    }
}

