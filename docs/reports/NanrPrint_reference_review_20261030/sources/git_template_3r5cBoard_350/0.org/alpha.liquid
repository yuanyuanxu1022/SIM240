FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      alpha.liquid;
}

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    top
    {
        type zeroGradient;
    }
    bottom
    {
        type zeroGradient;
    }
    left
    {
        type zeroGradient;
    }
    right
    {
        type zeroGradient;
    }
    front
    {
        type zeroGradient;
    }
    back
    {
        type zeroGradient;
    }
}

