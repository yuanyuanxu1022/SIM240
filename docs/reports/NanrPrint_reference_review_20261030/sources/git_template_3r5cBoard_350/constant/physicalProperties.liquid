FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      thermophysicalProperties.liquid;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState rhoConst;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        molWeight   202.0;  // Immersion Liquid 5095
    }
    equationOfState
    {
        rho         1510;   // kg/m3
    }
    thermodynamics
    {
        Cp          1800;   // J/(kg·K)
        Hf          0;
    }
    transport
    {
        mu          1e-3;   // Pa·s
        // mu          1e-4;   // Pa·s
        Pr          7;
    }
}

