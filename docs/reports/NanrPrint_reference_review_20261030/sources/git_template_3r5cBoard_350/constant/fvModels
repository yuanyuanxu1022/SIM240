FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      fvModels;
}


channelPorosity
{
    type            porosityForce;

    porosityForceCoeffs
    {
        cellZone        channelZone;

        type            DarcyForchheimer;

        d               (0 0 0);
        f               (0 0 0);

        coordinateSystem
        {
            type    cartesian;
            origin  (0 0 0);
            coordinateRotation
            {
                type    axesRotation;
                e1      (1 0 0);
                e2      (0 1 0);
            }
        }
    }
} // channel

