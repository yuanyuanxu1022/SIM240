    {
        type wall;
        faces ((4 5 6 7));
    }
    bottom
    {
        type wall;
        faces ((0 3 2 1));
    }
    left
    {
        type patch;
        faces ((3 0 4 7));
    }
    right
    {
        type patch;
        faces ((1 2 6 5));
    }
    front
