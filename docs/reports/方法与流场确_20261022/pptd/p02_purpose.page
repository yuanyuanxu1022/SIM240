      color: "#FFFFFF"
      text: 这份材料的目的与用法
  - elementType: text
    elementId: p02-pageno
    bounds: [856, 8, 68, 26]
    content:
      fontSize: 13
      color: "#FFFFFF"
      align: [right, top]
