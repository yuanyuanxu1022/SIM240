          textStyle: { fontSize: 11, color: "#4A5568" }
          cellStyle: { fill: { type: solid, color: "#FFFFFF" } }
      - - text: 物性/时间步
          textStyle: { bold: true, fontSize: 11, color: "#1A2230" }
          cellStyle: { fill: { type: solid, color: "#F7F9FC" } }
