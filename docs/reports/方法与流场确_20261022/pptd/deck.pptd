version: v2
title: 方法与流场确认（导师审阅版）
size: [960, 540]
theme:
  colors:
    primary: "#1E4FA8"
    navy: "#0E3F8C"
    midblue: "#3D7BD9"
    lightblue: "#E8EFF8"
    paleblue: "#F0F5FC"
    bgsoft: "#F7F9FC"
    alert: "#D9534F"
    textmain: "#1A2230"
    textsub: "#4A5568"
    textaux: "#8B97A8"
    line: "#D6DCE5"
  textStyles:
    h1:
      fontSize: 30
      bold: true
      color: "$navy"
      fontFamily: { ea: "Microsoft YaHei", latin: "Arial" }
    h2:
      fontSize: 20
      bold: true
      color: "$primary"
      fontFamily: { ea: "Microsoft YaHei", latin: "Arial" }
    body:
      fontSize: 14
      color: "$textmain"
      lineHeight: 1.3
      fontFamily: { ea: "Microsoft YaHei", latin: "Arial" }
    small:
      fontSize: 11
      color: "$textsub"
      lineHeight: 1.25
      fontFamily: { ea: "Microsoft YaHei", latin: "Arial" }
    tiny:
      fontSize: 9.5
      color: "$textaux"
      lineHeight: 1.2
      fontFamily: { ea: "Microsoft YaHei", latin: "Arial" }
pages:
  - p01_cover.page
  - p02_purpose.page
  - p03_catalog.page
  - p04_sec1_gate.page
  - p05_reviewer_points.page
  - p06_method_elements.page
  - p07_sec2_confirm.page
  - p08_geometry.page
  - p09_units_chain.page
  - p10_definitions.page
  - p11_verification_chain.page
  - p12_limitations.page
  - p13_sec3_flow.page
  - p14_flow_fig1.page
  - p15_flow_fig2_fig4.page
  - p16_flow_fig3_preview.page
  - p17_sec4_decide.page
  - p18_three_questions.page
